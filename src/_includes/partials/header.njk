{% set currentSection = page.url.split('/')[1] %}
<header class="border-b border-neutral-900/15 dark:border-stone-50/15">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-4">
    <a
      class="inline-flex items-center gap-3 text-lg font-semibold tracking-normal no-underline hover:underline"
      href="{{ '/' | url }}"
      aria-label="Haha Systems — home"
    >
      {% include "partials/mark.njk" %}
      <span>Haha Systems</span>
    </a>
    <nav class="flex flex-wrap items-center gap-4 font-mono text-sm" aria-label="Primary">
      {% for s in site.sections %}
        <a
          class="no-underline hover:underline{% if currentSection == s.slug %} font-semibold underline{% endif %}"
          href="{{ ('/' + s.slug + '/') | url }}"
          {% if currentSection == s.slug %}aria-current="page"{% endif %}
        >{{ s.title }}</a>
      {% endfor %}
    </nav>
  </div>
</header>

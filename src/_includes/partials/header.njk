{% set currentSection = page.url.split('/')[1] %}
<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="site-id" href="{{ '/' | url }}" aria-label="Haha Systems — home">
      {% include "partials/mark.njk" %}
      <span class="site-id__text">
        <span class="site-id__name">Haha Systems</span>
        <span class="site-id__sub">Frontier research in intelligence</span>
      </span>
    </a>
    <nav class="site-nav" aria-label="Primary">
      <ul>
        {% for s in site.sections %}
          <li>
            <a
              href="{{ ('/' + s.slug + '/') | url }}"
              {% if currentSection == s.slug %}aria-current="page"{% endif %}
            >{{ s.title }}</a>
          </li>
        {% endfor %}
      </ul>
    </nav>
  </div>
</header>

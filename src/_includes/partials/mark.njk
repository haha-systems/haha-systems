{# Inline SVG mark for Haha Systems. Two stacked half-rings forming an "H" cog;
   reads as a workshop / mechanism glyph at 24px, holds up at 200px. #}
<svg
  class="mark"
  viewBox="0 0 48 48"
  width="{{ size or 32 }}"
  height="{{ size or 32 }}"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  aria-label="Haha Systems mark"
  role="img"
>
  <rect x="6" y="6" width="36" height="36" rx="0" />
  <line x1="6"  y1="24" x2="42" y2="24" />
  <line x1="24" y1="6"  x2="24" y2="42" />
  <circle cx="24" cy="24" r="6" />
</svg>

---
layout: layouts/base.njk
---
<article class="max-w-4xl">
  <header>
    {% if kicker %}<p class="m-0 font-mono text-sm uppercase tracking-widest text-neutral-600 dark:text-neutral-400">{{ kicker }}</p>{% endif %}
    <h1 class="{% if kicker %}mt-3{% else %}mt-0{% endif %} text-4xl font-semibold leading-tight">{{ title }}</h1>
    {% if subtitle %}<p class="mt-3 max-w-2xl leading-relaxed text-neutral-700 dark:text-neutral-400">{{ subtitle }}</p>{% endif %}
  </header>
  <div class="prose mt-8">
    {{ content | safe }}
  </div>
</article>

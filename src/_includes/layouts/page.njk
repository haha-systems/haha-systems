---
layout: layouts/base.njk
---
<article class="page wrap">
  <header class="page__header">
    <p class="page__kicker">{{ kicker or "" }}</p>
    <h1 class="page__title">{{ title }}</h1>
    {% if subtitle %}<p class="page__subtitle">{{ subtitle }}</p>{% endif %}
  </header>
  <div class="prose">
    {{ content | safe }}
  </div>
</article>

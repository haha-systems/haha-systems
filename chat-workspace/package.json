{
  "name": "@haha-systems/chat-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chat-native agent workspace foundation.",
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "tsx src/server/index.ts",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "NODE_ENV=production node dist/server/src/server/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "db:migrate": "tsx scripts/migrate.ts",
    "verify:chat-core": "tsx scripts/verify-chat-core.ts",
    "verify:ws": "tsx scripts/verify-ws.ts",
    "verify:boot": "tsx scripts/verify-boot.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.10",
    "@vitejs/plugin-react": "^5.0.1",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^7.1.3",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2"
  }
}
